# Copy to .env.local to override defaults.

# Where the Vite dev server proxies /api/* (default: http://localhost:5204,
# which is the Gym API's "http" launch profile).
# VITE_API_PROXY_TARGET=http://localhost:5204

# Absolute API base URL. Set this to bypass the dev proxy (e.g. a deployed API).
# Default is "/api" (proxied).
# VITE_API_BASE_URL=https://gym-api.example.com/api
